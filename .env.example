# Copy this file to `.env` and fill in real values. Do not commit `.env`.

DEEPGRAM_API_KEY=
GROQ_API_KEY=
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

SAMPLE_RATE=16000
CHANNELS=1

VAD_AGGRESSIVENESS=2
SILENCE_THRESHOLD_MS=800

LLM_MODEL=llama-3.3-70b-versatile
LLM_MAX_TOKENS=300
MAX_HISTORY_TURNS=5

# Optional: spoken once at startup (leave unset to use default in config.py)
# STARTUP_GREETING=

LOG_LEVEL=DEBUG
LOG_FILE=logs/agent.log
